{
  "name": "tsc-committed",
  "version": "1.1.1",
  "description": "A CLI tool to report tsc errors on committed files between base branch and feature branch in a git repo",
  "main": "dist/index.js",
  "bin": {
    "tsc-committed": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "start": "tsup --watch",
    "build": "tsup",
    "lint": "eslint --ext .ts src",
    "format": "prettier --write src",
    "prepush": "yarn lint",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky install",
    "release:beta": "release-it --preRelease=beta",
    "release": "release-it"
  },
  "engines": {
    "node": ">=10"
  },
  "keywords": [
    "tsc",
    "typescript",
    "lint",
    "commit",
    "pre-commit",
    "pre-push",
    "precommit",
    "prepush",
    "hook",
    "git",
    "husky",
    "git-hook"
  ],
  "author": "Vinoth Pandian",
  "license": "MIT",
  "repository": "https://github.com/vinothpandian/tsc-committed.git",
  "devDependencies": {
    "@release-it/keep-a-changelog": "^8.0.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/figlet": "^1.12.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^18.19.130",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-typescript-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "prettier": "^2.8.8",
    "release-it": "^21.1.2",
    "tsup": "^9.0.0",
    "typescript": "^4.9.5",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --fix",
    "*.src": "prettier --write"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^10.0.1",
    "execa": "^7.2.0",
    "figlet": "^1.12.0",
    "lodash-es": "^4.18.1",
    "ora": "^6.3.1"
  }
}
